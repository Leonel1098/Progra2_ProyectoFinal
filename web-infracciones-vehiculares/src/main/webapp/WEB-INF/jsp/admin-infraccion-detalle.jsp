<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Detalle de infracción</title><script src="https://cdn.tailwindcss.com"></script></head><body class="min-h-screen bg-slate-100 p-4 text-slate-800"><main class="mx-auto max-w-3xl rounded-2xl border bg-white p-5 shadow-sm sm:p-8"><a class="text-sm font-bold text-blue-800 underline" href="${pageContext.request.contextPath}/admin/infracciones">← Volver a infracciones</a><c:if test="${not empty error}"><p class="mt-4 rounded-xl bg-rose-50 p-3 text-rose-800"><c:out value="${error}"/></p></c:if><c:if test="${not empty infraccion}"><h1 class="mt-5 text-2xl font-extrabold">Detalle <c:out value="${infraccion.numeroInfraccion}"/></h1><dl class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2"><c:forEach var="campo" items="${infraccion}"><div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs font-bold uppercase text-slate-500"><c:out value="${campo.key}"/></dt><dd class="mt-1 break-words font-medium"><c:out value="${campo.value}"/></dd></div></c:forEach></dl></c:if></main></body></html>
