<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Admin · <c:out value="${seccion}"/></title>
<script src="https://cdn.tailwindcss.com"></script><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"><script>tailwind.config={theme:{extend:{fontFamily:{sans:['Plus Jakarta Sans','sans-serif']},colors:{brand:{50:'#eef5fc',100:'#d7e7f9',500:'#1a4b8c',600:'#153e74',700:'#0f2f59',800:'#0b213f'}}}}}</script></head>
<body class="min-h-screen bg-slate-100 font-sans text-slate-800 lg:flex">
<%@ include file="admin-nav.jspf" %>
<div class="min-w-0 flex-1"><header class="sticky top-0 z-20 flex items-center justify-between border-b bg-white/95 px-4 py-3 backdrop-blur lg:px-7"><div><span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Rol: Admin</span><h1 class="text-lg font-extrabold"><c:out value="${seccion}"/></h1></div><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><button class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold">Cerrar sesión</button></form></header>
<main class="mx-auto max-w-screen-2xl space-y-4 p-4 lg:p-7">
    <nav class="grid grid-cols-2 gap-2 rounded-xl bg-white p-2 text-xs font-bold lg:hidden"><a class="rounded-lg p-2 text-center ${activeTab eq 'infracciones' ? 'bg-brand-700 text-white' : 'bg-slate-50 text-slate-700'}" href="${pageContext.request.contextPath}/admin/infracciones">Infracciones</a><a class="rounded-lg p-2 text-center ${activeTab eq 'personas' ? 'bg-brand-700 text-white' : 'bg-slate-50 text-slate-700'}" href="${pageContext.request.contextPath}/admin/personas">Personas</a><a class="rounded-lg p-2 text-center ${activeTab eq 'vehiculos' ? 'bg-brand-700 text-white' : 'bg-slate-50 text-slate-700'}" href="${pageContext.request.contextPath}/admin/vehiculos">Veh&iacute;culos</a><a class="rounded-lg p-2 text-center ${activeTab eq 'tipos' ? 'bg-brand-700 text-white' : 'bg-slate-50 text-slate-700'}" href="${pageContext.request.contextPath}/admin/tipos-infraccion">Tipos</a><a class="rounded-lg p-2 text-center ${activeTab eq 'usuarios' ? 'bg-brand-700 text-white' : 'bg-slate-50 text-slate-700'}" href="${pageContext.request.contextPath}/admin/usuarios">Usuarios</a><a class="rounded-lg bg-slate-50 p-2 text-center text-slate-700" href="${pageContext.request.contextPath}/inicio">Inicio</a></nav>
    <c:if test="${not empty exito}"><div role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900"><c:out value="${exito}"/></div></c:if><c:if test="${not empty error}"><div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800"><c:out value="${error}"/></div></c:if>
    <c:if test="${not empty errorPersonas}"><div class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900"><c:out value="${errorPersonas}"/></div></c:if>
    <form method="get" action="${pageContext.request.contextPath}${basePath}" class="flex flex-col gap-2 rounded-2xl border bg-white p-4 sm:flex-row"><input name="${paramBusqueda}" value="<c:out value='${busqueda}'/>" placeholder="<c:out value='${placeholderBusqueda}'/>" class="min-w-0 flex-1 rounded-xl border bg-slate-50 px-3 py-2 text-sm"><button class="rounded-xl bg-brand-700 px-4 py-2 text-sm font-bold text-white">Buscar</button><a href="${pageContext.request.contextPath}${basePath}" class="rounded-xl bg-slate-100 px-4 py-2 text-center text-sm font-bold">Limpiar</a></form>

    <c:choose>
        <c:when test="${seccion eq 'Personas'}"><section class="rounded-2xl border bg-white p-5"><h2 class="mb-3 text-lg font-extrabold">Crear persona</h2><form method="post" action="${pageContext.request.contextPath}/admin/personas/crear" class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input name="dpi" required maxlength="13" inputmode="numeric" placeholder="DPI de 13 dígitos" class="rounded-xl border px-3 py-2"><input name="nombre" required maxlength="100" placeholder="Nombre(s)" class="rounded-xl border px-3 py-2"><input name="apellido" required maxlength="100" placeholder="Apellido(s)" class="rounded-xl border px-3 py-2"><input name="telefono" maxlength="20" placeholder="Teléfono" class="rounded-xl border px-3 py-2"><input name="direccion" maxlength="200" placeholder="Dirección" class="rounded-xl border px-3 py-2"><button class="rounded-xl bg-brand-700 px-4 py-2 font-bold text-white">Crear persona</button></form></section></c:when>
        <c:when test="${seccion eq 'Vehículos'}"><section class="rounded-2xl border bg-white p-5"><h2 class="mb-3 text-lg font-extrabold">Crear vehículo</h2><form method="post" action="${pageContext.request.contextPath}/admin/vehiculos/crear" class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input name="placa" required maxlength="7" placeholder="Placa completa (P123ABC)" class="rounded-xl border px-3 py-2"><input name="marca" required maxlength="60" placeholder="Marca" class="rounded-xl border px-3 py-2"><input name="modelo" required maxlength="60" placeholder="Modelo" class="rounded-xl border px-3 py-2"><input name="color" required maxlength="40" placeholder="Color" class="rounded-xl border px-3 py-2"><button class="rounded-xl bg-brand-700 px-4 py-2 font-bold text-white sm:col-span-2 lg:col-span-4">Crear vehículo</button></form></section></c:when>
        <c:when test="${seccion eq 'Tipos de infracción'}"><section class="rounded-2xl border bg-white p-5"><h2 class="mb-3 text-lg font-extrabold">Crear tipo de infracción</h2><form method="post" action="${pageContext.request.contextPath}/admin/tipos-infraccion/crear" class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input name="codigo" required maxlength="30" placeholder="Código" class="rounded-xl border px-3 py-2"><input name="nombre" required maxlength="120" placeholder="Nombre" class="rounded-xl border px-3 py-2"><input name="monto" type="number" min="0" step="0.01" required placeholder="Monto Q" class="rounded-xl border px-3 py-2"><input name="descripcion" maxlength="300" placeholder="Descripción" class="rounded-xl border px-3 py-2"><button class="rounded-xl bg-brand-700 px-4 py-2 font-bold text-white sm:col-span-2 lg:col-span-4">Crear tipo</button></form></section></c:when>
        <c:when test="${seccion eq 'Usuarios y roles'}"><section class="rounded-2xl border bg-white p-5"><h2 class="mb-3 text-lg font-extrabold">Crear usuario</h2><form method="post" action="${pageContext.request.contextPath}/admin/usuarios/crear" class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-5"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><select name="dpiPersona" required class="rounded-xl border bg-white px-3 py-2"><option value="">Persona asociada</option><c:forEach var="p" items="${personas}"><option value="<c:out value='${p.dpiPersona}'/>"><c:out value="${p.nombrePersona}"/> <c:out value="${p.apellidoPersona}"/> · <c:out value="${p.dpiPersona}"/></option></c:forEach></select><input name="usuario" required maxlength="20" placeholder="Usuario" class="rounded-xl border px-3 py-2"><input name="contrasena" type="password" required minlength="8" maxlength="128" autocomplete="new-password" placeholder="Contraseña inicial" class="rounded-xl border px-3 py-2"><select name="nombreRol" required class="rounded-xl border bg-white px-3 py-2"><option value="">Rol</option><c:forEach var="r" items="${roles}"><option value="${r}"><c:out value="${r}"/></option></c:forEach></select><select name="estado" class="rounded-xl border bg-white px-3 py-2"><option value="true">Activo</option><option value="false">Inactivo</option></select><button class="rounded-xl bg-brand-700 px-4 py-2 font-bold text-white sm:col-span-2 lg:col-span-5">Crear usuario</button></form></section></c:when>
    </c:choose>

    <section class="overflow-hidden rounded-2xl border bg-white shadow-sm"><div class="border-b p-4"><h2 class="font-extrabold">Registros</h2><p class="text-xs text-slate-500"><c:out value="${registros.size()}"/> elemento(s)</p></div>
        <div class="divide-y"><c:forEach var="r" items="${registros}"><article class="p-4 sm:p-5">
            <c:choose><c:when test="${seccion eq 'Personas'}"><h3 class="font-bold"><c:out value="${r.nombrePersona}"/> <c:out value="${r.apellidoPersona}"/></h3><p class="mt-1 text-sm text-slate-500">DPI <c:out value="${r.dpiPersona}"/> · <c:out value="${r.telefonoPersona}"/> · <c:out value="${r.direccionPersona}"/></p></c:when>
                <c:when test="${seccion eq 'Vehículos'}"><h3 class="font-bold"><c:out value="${r.placa}"/> · <c:out value="${r.marca}"/> <c:out value="${r.modelo}"/></h3><p class="mt-1 text-sm text-slate-500">Color <c:out value="${r.color}"/></p></c:when>
                <c:when test="${seccion eq 'Tipos de infracción'}"><h3 class="font-bold"><c:out value="${r.codigo}"/> · <c:out value="${r.nombre}"/></h3><p class="mt-1 text-sm text-slate-500"><c:out value="${r.descripcion}"/> · Q <c:out value="${r.monto}"/></p></c:when>
                <c:otherwise><h3 class="font-bold"><c:out value="${r.usuario}"/> · <c:out value="${r.nombreRol}"/></h3><p class="mt-1 text-sm text-slate-500">DPI <c:out value="${r.dpiPersona}"/> · Estado <c:out value="${r.estado}"/></p></c:otherwise></c:choose>
            <details class="mt-3"><summary class="w-fit cursor-pointer text-xs font-bold text-brand-700 underline">Editar</summary>
                <c:choose><c:when test="${seccion eq 'Personas'}"><form method="post" action="${pageContext.request.contextPath}/admin/personas/actualizar" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="dpi" value="<c:out value='${r.dpiPersona}'/>"><input value="<c:out value='${r.nombrePersona}'/>" name="nombre" required class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.apellidoPersona}'/>" name="apellido" required class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.telefonoPersona}'/>" name="telefono" class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.direccionPersona}'/>" name="direccion" class="rounded-lg border px-3 py-2"><button class="rounded-lg bg-blue-700 px-3 py-2 font-bold text-white sm:col-span-2">Guardar cambios</button></form></c:when>
                    <c:when test="${seccion eq 'Vehículos'}"><form method="post" action="${pageContext.request.contextPath}/admin/vehiculos/actualizar" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="placa" value="<c:out value='${r.placa}'/>"><input value="<c:out value='${r.marca}'/>" name="marca" required class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.modelo}'/>" name="modelo" required class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.color}'/>" name="color" required class="rounded-lg border px-3 py-2"><button class="rounded-lg bg-blue-700 px-3 py-2 font-bold text-white sm:col-span-2">Guardar cambios</button></form></c:when>
                    <c:when test="${seccion eq 'Tipos de infracción'}"><form method="post" action="${pageContext.request.contextPath}/admin/tipos-infraccion/actualizar" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="id" value="<c:out value='${r.idTipoInfraccion}'/>"><input value="<c:out value='${r.codigo}'/>" name="codigo" required class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.nombre}'/>" name="nombre" required class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.monto}'/>" name="monto" type="number" min="0" step="0.01" required class="rounded-lg border px-3 py-2"><input value="<c:out value='${r.descripcion}'/>" name="descripcion" class="rounded-lg border px-3 py-2"><button class="rounded-lg bg-blue-700 px-3 py-2 font-bold text-white sm:col-span-2">Guardar cambios</button></form></c:when>
                    <c:otherwise><form method="post" action="${pageContext.request.contextPath}/admin/usuarios/actualizar" class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="usuario" value="<c:out value='${r.usuario}'/>"><select name="nombreRol" class="rounded-lg border px-3 py-2"><c:forEach var="rol" items="${roles}"><option value="${rol}" ${rol eq r.nombreRol ? 'selected' : ''}><c:out value="${rol}"/></option></c:forEach></select><select name="estado" class="rounded-lg border px-3 py-2"><option value="true" ${r.estado eq 'true' ? 'selected' : ''}>Activo</option><option value="false" ${r.estado eq 'false' ? 'selected' : ''}>Inactivo</option></select><button class="rounded-lg bg-blue-700 px-3 py-2 font-bold text-white sm:col-span-2">Actualizar usuario</button></form></c:otherwise></c:choose>
            </details>
            <c:if test="${seccion eq 'Usuarios y roles'}"><form method="post" action="${pageContext.request.contextPath}/admin/usuarios/contrasena" class="mt-3 grid grid-cols-1 gap-2 rounded-xl border border-slate-200 bg-slate-50 p-3 sm:grid-cols-2"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="usuario" value="<c:out value='${r.usuario}'/>"><input name="nuevaContrasena" type="password" required minlength="8" maxlength="128" autocomplete="new-password" placeholder="Nueva contraseña (8 a 128 caracteres)" class="rounded-lg border px-3 py-2"><input name="confirmarContrasena" type="password" required minlength="8" maxlength="128" autocomplete="new-password" placeholder="Confirmar nueva contraseña" class="rounded-lg border px-3 py-2"><button class="rounded-lg bg-brand-700 px-3 py-2 text-sm font-bold text-white sm:col-span-2">Actualizar contraseña</button></form><form method="post" action="${pageContext.request.contextPath}/admin/usuarios/eliminar" class="mt-3" onsubmit="return confirm('¿Confirmas eliminar este usuario? Esta acción no se puede deshacer.')"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="usuario" value="<c:out value='${r.usuario}'/>"><button class="text-xs font-bold text-rose-700 underline">Eliminar usuario</button></form></c:if>
            <c:if test="${seccion eq 'Personas'}"><form method="post" action="${pageContext.request.contextPath}/admin/personas/eliminar" class="mt-3" onsubmit="return confirm('¿Confirmas eliminar esta persona? Esta acción no se puede deshacer.')"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="dpi" value="<c:out value='${r.dpiPersona}'/>"><button class="text-xs font-bold text-rose-700 underline">Eliminar persona</button></form></c:if>
            <c:if test="${seccion eq 'Vehículos'}"><form method="post" action="${pageContext.request.contextPath}/admin/vehiculos/eliminar" class="mt-3" onsubmit="return confirm('¿Confirmas eliminar este vehículo? Esta acción no se puede deshacer.')"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="placa" value="<c:out value='${r.placa}'/>"><button class="text-xs font-bold text-rose-700 underline">Eliminar vehículo</button></form></c:if>
            <c:if test="${seccion eq 'Tipos de infracción'}"><form method="post" action="${pageContext.request.contextPath}/admin/tipos-infraccion/eliminar" class="mt-3" onsubmit="return confirm('¿Confirmas eliminar este tipo de infracción? Esta acción no se puede deshacer.')"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><input type="hidden" name="id" value="<c:out value='${r.idTipoInfraccion}'/>"><button class="text-xs font-bold text-rose-700 underline">Eliminar tipo</button></form></c:if>
        </article></c:forEach><c:if test="${empty registros}"><p class="p-8 text-center text-sm text-slate-500">No hay registros para mostrar.</p></c:if></div>
    </section>
</main></div></body></html>
