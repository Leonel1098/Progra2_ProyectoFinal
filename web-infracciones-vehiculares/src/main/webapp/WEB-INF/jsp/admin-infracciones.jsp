<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="es"><head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Admin · Infracciones</title><script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"><script src="https://unpkg.com/lucide@latest"></script>
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Plus Jakarta Sans','sans-serif'],mono:['JetBrains Mono','monospace']},colors:{brand:{50:'#eef5fc',100:'#d7e7f9',200:'#b9d3f2',500:'#1a4b8c',600:'#153e74',700:'#0f2f59',800:'#0b213f',900:'#07162b'}}}}}</script>
</head><body class="min-h-screen bg-slate-100 font-sans text-slate-800 lg:flex">
<aside class="hidden h-screen w-64 shrink-0 flex-col border-r border-slate-200 bg-white lg:sticky lg:top-0 lg:flex">
    <div class="border-b p-5"><p class="text-xs font-bold uppercase tracking-wider text-brand-600">Movilidad &amp; Tr&aacute;nsito</p><h1 class="mt-1 font-extrabold">Panel Admin</h1></div>
    <nav class="flex-1 space-y-1 p-3 text-sm">
        <a class="flex items-center gap-2 rounded-xl bg-brand-700 px-3 py-2.5 font-bold text-white" href="${pageContext.request.contextPath}/admin/infracciones"><i data-lucide="file-text" class="h-4 w-4"></i>Infracciones</a>
        <a class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-100" href="${pageContext.request.contextPath}/admin/personas"><i data-lucide="users" class="h-4 w-4"></i>Personas</a>
        <a class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-100" href="${pageContext.request.contextPath}/admin/vehiculos"><i data-lucide="car" class="h-4 w-4"></i>Vehículos</a>
        <a class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-100" href="${pageContext.request.contextPath}/admin/tipos-infraccion"><i data-lucide="list-checks" class="h-4 w-4"></i>Tipos de infracción</a>
        <a class="flex items-center gap-2 rounded-xl px-3 py-2.5 text-slate-600 hover:bg-slate-100" href="${pageContext.request.contextPath}/admin/usuarios"><i data-lucide="user-cog" class="h-4 w-4"></i>Usuarios y roles</a>
    </nav>
    <div class="border-t p-3"><a class="block rounded-xl px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-100" href="${pageContext.request.contextPath}/inicio">&larr; Volver al inicio</a></div>
</aside>
<div class="min-w-0 flex-1">
    <header class="sticky top-0 z-20 flex items-center justify-between border-b bg-white/95 px-4 py-3 backdrop-blur lg:px-7">
        <div><span class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Rol: Admin</span><h2 class="text-lg font-extrabold">Gestión de infracciones</h2></div>
        <div class="flex items-center gap-2"><a href="${pageContext.request.contextPath}/agente/infracciones/nueva" class="rounded-xl bg-brand-700 px-3 py-2 text-xs font-bold text-white hover:bg-brand-800">Nueva infracción</a><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><button class="rounded-xl bg-slate-100 px-3 py-2 text-xs font-bold">Salir</button></form></div>
    </header>
    <main class="mx-auto max-w-screen-2xl space-y-4 p-4 lg:space-y-5 lg:p-7">
        <nav class="grid grid-cols-2 gap-2 rounded-xl bg-white p-2 text-xs font-bold lg:hidden"><a class="rounded-lg bg-brand-700 p-2 text-center text-white" href="${pageContext.request.contextPath}/admin/infracciones">Infracciones</a><a class="rounded-lg bg-slate-50 p-2 text-center" href="${pageContext.request.contextPath}/admin/personas">Personas</a><a class="rounded-lg bg-slate-50 p-2 text-center" href="${pageContext.request.contextPath}/admin/vehiculos">Vehículos</a><a class="rounded-lg bg-slate-50 p-2 text-center" href="${pageContext.request.contextPath}/admin/tipos-infraccion">Tipos</a><a class="rounded-lg bg-slate-50 p-2 text-center" href="${pageContext.request.contextPath}/admin/usuarios">Usuarios</a><a class="rounded-lg bg-slate-50 p-2 text-center" href="${pageContext.request.contextPath}/inicio">Inicio</a></nav>
        <c:if test="${not empty exito}"><div role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900"><c:out value="${exito}"/></div></c:if>
        <c:if test="${not empty error}"><div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800"><c:out value="${error}"/></div></c:if>
        <section class="grid grid-cols-1 gap-3 sm:grid-cols-3">
            <article class="rounded-2xl border bg-white p-4"><p class="text-xs font-bold uppercase text-slate-500">Registros filtrados</p><strong class="mt-1 block font-mono text-2xl"><c:out value="${total}" default="0"/></strong></article>
            <article class="rounded-2xl border bg-white p-4"><p class="text-xs font-bold uppercase text-amber-700">Pendientes</p><strong class="mt-1 block font-mono text-2xl text-amber-700"><c:out value="${totalPendientes}" default="0"/></strong></article>
            <article class="rounded-2xl border bg-white p-4"><p class="text-xs font-bold uppercase text-emerald-700">Pagadas</p><strong class="mt-1 block font-mono text-2xl text-emerald-700"><c:out value="${totalPagadas}" default="0"/></strong></article>
        </section>
        <form method="get" action="${pageContext.request.contextPath}/admin/infracciones" class="grid grid-cols-1 gap-2 rounded-2xl border bg-white p-4 sm:grid-cols-2 xl:grid-cols-6">
            <select name="buscarPor" class="rounded-xl border bg-slate-50 px-3 py-2 text-sm" aria-label="Buscar infracciones por">
                <option value="TODOS" ${buscarPor eq 'TODOS' ? 'selected' : ''}>Buscar en todo</option>
                <option value="PLACA" ${buscarPor eq 'PLACA' ? 'selected' : ''}>Por placa</option>
                <option value="NUMERO" ${buscarPor eq 'NUMERO' ? 'selected' : ''}>Por número</option>
                <option value="DPI" ${buscarPor eq 'DPI' ? 'selected' : ''}>Por DPI</option>
            </select>
            <input name="q" value="<c:out value='${q}'/>" placeholder="Boleta, placa, motivo, DPI" class="rounded-xl border bg-slate-50 px-3 py-2 text-sm">
            <select name="estado" class="rounded-xl border bg-slate-50 px-3 py-2 text-sm"><option value="">Todos los estados</option><c:forEach var="e" items="${estados}"><option value="<c:out value='${e}'/>" ${e eq estado ? 'selected' : ''}><c:out value="${e}"/></option></c:forEach></select>
            <select name="tipo" class="rounded-xl border bg-slate-50 px-3 py-2 text-sm"><option value="">Todos los tipos</option><c:forEach var="t" items="${tipos}"><option value="<c:out value='${t}'/>" ${t eq tipo ? 'selected' : ''}><c:out value="${t}"/></option></c:forEach></select>
            <input type="date" name="fecha" value="<c:out value='${fecha}'/>" class="rounded-xl border bg-slate-50 px-3 py-2 text-sm">
            <div class="flex gap-2"><button class="flex-1 rounded-xl bg-brand-700 px-3 py-2 text-sm font-bold text-white">Filtrar</button><a href="${pageContext.request.contextPath}/admin/infracciones" class="rounded-xl bg-slate-100 px-3 py-2 text-sm font-bold">Limpiar</a></div>
        </form>
        <section class="overflow-hidden rounded-2xl border bg-white shadow-sm">
            <div class="flex items-center justify-between border-b p-4"><h3 class="font-extrabold">Infracciones registradas</h3><span class="text-xs text-slate-500">Página ${pagina + 1} · ${tamano} por página</span></div>
            <div class="hidden overflow-x-auto md:block"><table class="min-w-full text-left text-sm"><thead class="bg-brand-800 text-xs uppercase tracking-wide text-white"><tr><th class="px-4 py-3">N° Boleta</th><th class="px-4 py-3">Placa</th><th class="px-4 py-3">Infracción</th><th class="px-4 py-3">Lugar</th><th class="px-4 py-3">Fecha</th><th class="px-4 py-3 text-right">Monto</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3">Acciones</th></tr></thead><tbody class="divide-y"><c:forEach var="inf" items="${infracciones}"><tr class="odd:bg-white even:bg-slate-50/70"><td class="whitespace-nowrap px-4 py-3 font-mono font-bold text-brand-700"><c:out value="${inf.numeroInfraccion}"/></td><td class="px-4 py-3 font-mono"><c:out value="${inf.placaVehiculo}"/></td><td class="px-4 py-3 font-semibold"><c:out value="${inf.tipoInfraccion}"/></td><td class="max-w-xs px-4 py-3"><c:out value="${inf.direccionInfraccion}"/></td><td class="whitespace-nowrap px-4 py-3"><c:out value="${inf.fechaInfraccion}"/></td><td class="whitespace-nowrap px-4 py-3 text-right font-mono font-bold">Q <c:out value="${inf.montoOriginal}"/></td><td class="px-4 py-3"><span class="rounded-full border px-2 py-1 text-xs font-bold ${inf.estado eq 'Pendiente' ? 'border-amber-200 bg-amber-50 text-amber-700' : (inf.estado eq 'Anulada' or inf.estado eq 'Anulado' ? 'border-slate-200 bg-slate-100 text-slate-600' : 'border-emerald-200 bg-emerald-50 text-emerald-700')}"><c:out value="${inf.estado}"/></span></td><td class="whitespace-nowrap px-4 py-3"><a class="mr-2 font-bold text-brand-700 underline" href="${pageContext.request.contextPath}/admin/infracciones/${inf.numeroInfraccion}">Ver</a><c:choose><c:when test="${inf.estado eq 'Pagada'}"><span class="text-xs font-semibold text-slate-500">No se puede anular: ya está pagada</span></c:when><c:when test="${inf.estado ne 'Anulada' and inf.estado ne 'Anulado'}"><button type="button" class="font-bold text-rose-700 underline" data-numero="<c:out value='${inf.numeroInfraccion}'/>" onclick="confirmarAnulacion(this)">Anular</button></c:when></c:choose></td></tr></c:forEach></tbody></table></div>
            <div class="divide-y md:hidden"><c:forEach var="inf" items="${infracciones}"><article class="space-y-2 p-4"><div class="flex items-start justify-between gap-2"><a class="break-all font-mono text-sm font-bold text-brand-700" href="${pageContext.request.contextPath}/admin/infracciones/${inf.numeroInfraccion}"><c:out value="${inf.numeroInfraccion}"/></a><span class="rounded-full border px-2 py-1 text-[11px] font-bold"><c:out value="${inf.estado}"/></span></div><p class="font-bold"><c:out value="${inf.tipoInfraccion}"/></p><div class="flex flex-wrap gap-3 text-xs text-slate-500"><span>Placa <strong class="font-mono text-slate-800"><c:out value="${inf.placaVehiculo}"/></strong></span><span><c:out value="${inf.fechaInfraccion}"/></span><span>Q <c:out value="${inf.montoOriginal}"/></span></div><p class="break-words text-xs text-slate-500"><c:out value="${inf.direccionInfraccion}"/></p><c:choose><c:when test="${inf.estado eq 'Pagada'}"><p class="text-xs font-semibold text-slate-500">No se puede anular: ya está pagada.</p></c:when><c:when test="${inf.estado ne 'Anulada' and inf.estado ne 'Anulado'}"><button type="button" class="text-xs font-bold text-rose-700 underline" data-numero="<c:out value='${inf.numeroInfraccion}'/>" onclick="confirmarAnulacion(this)">Anular infracción</button></c:when></c:choose></article></c:forEach></div>
            <c:if test="${empty infracciones}"><p class="p-8 text-center text-sm text-slate-500">No se encontraron infracciones.</p></c:if>
            <c:if test="${totalPaginas gt 1}"><div class="flex items-center justify-between border-t p-4 text-sm"><c:choose><c:when test="${pagina gt 0}"><c:url var="prev" value="/admin/infracciones"><c:param name="q" value="${q}"/><c:param name="buscarPor" value="${buscarPor}"/><c:param name="estado" value="${estado}"/><c:param name="tipo" value="${tipo}"/><c:param name="fecha" value="${fecha}"/><c:param name="pagina" value="${pagina - 1}"/></c:url><a class="rounded-lg border px-3 py-2 font-bold" href="${prev}">← Anterior</a></c:when><c:otherwise><span class="text-slate-300">← Anterior</span></c:otherwise></c:choose><span class="text-slate-500">${pagina + 1} / ${totalPaginas}</span><c:choose><c:when test="${pagina + 1 lt totalPaginas}"><c:url var="next" value="/admin/infracciones"><c:param name="q" value="${q}"/><c:param name="buscarPor" value="${buscarPor}"/><c:param name="estado" value="${estado}"/><c:param name="tipo" value="${tipo}"/><c:param name="fecha" value="${fecha}"/><c:param name="pagina" value="${pagina + 1}"/></c:url><a class="rounded-lg border px-3 py-2 font-bold" href="${next}">Siguiente →</a></c:when><c:otherwise><span class="text-slate-300">Siguiente →</span></c:otherwise></c:choose></div></c:if>
        </section>
    </main>
</div>
<dialog id="anularDialogo" class="w-[min(92vw,26rem)] rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50"><form id="formAnular" method="post" class="space-y-4 p-5"><input type="hidden" name="_csrf" value="<c:out value='${sessionScope.csrfToken}'/>"><h3 class="text-lg font-extrabold">¿Anular esta infracción?</h3><p class="text-sm text-slate-600">La acción será procesada y cambiará su estado. Boleta: <strong id="numeroAnular" class="font-mono"></strong></p><div class="flex gap-2"><button type="button" onclick="document.getElementById('anularDialogo').close()" class="flex-1 rounded-xl bg-slate-100 px-3 py-2 font-bold">Cancelar</button><button class="flex-1 rounded-xl bg-rose-700 px-3 py-2 font-bold text-white">Confirmar anulación</button></div></form></dialog>
<script>
function confirmarAnulacion(boton){const n=boton.dataset.numero;document.getElementById('numeroAnular').textContent=n;document.getElementById('formAnular').action='${pageContext.request.contextPath}/admin/infracciones/'+encodeURIComponent(n)+'/anular';document.getElementById('anularDialogo').showModal();}
lucide.createIcons();
</script></body></html>
