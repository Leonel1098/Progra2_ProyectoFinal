
spring.application.name=web-infracciones-vehiculares

# Puerto del frontend
server.port=8081

# Ubicación de las vistas JSP
spring.mvc.view.prefix=/WEB-INF/jsp/
spring.mvc.view.suffix=.jsp

#Endpoints del Backend

#CONSULTA INFRACCIONES INICIO
soap.infracciones.url = http://localhost:8080/services/infracciones

# Autenticación
soap.auth.url=http://localhost:8080/services/auth

# Sesión web
server.servlet.session.timeout=30m
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.same-site=lax
server.servlet.session.tracking-modes=cookie
soap.pagos.url=http://localhost:8080/services/pagos
